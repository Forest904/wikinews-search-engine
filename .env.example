# Development only. Copy this file to .env and choose a strong local password.
ELASTIC_PASSWORD=change_me_before_running
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=wikinews_standard_v1
ELASTICSEARCH_ITALIAN_INDEX=wikinews_italian_v1
ELASTICSEARCH_TIMEOUT=5
ES_PORT=9200
ANNOTATION_DB=data/annotation/annotation.sqlite3
# Set to 1 when serving through HTTPS (M7-A).
ANNOTATION_COOKIE_SECURE=0

# Mostra la ricerca semantica dopo la verifica della collezione Qdrant.
SEMANTIC_ENABLED=0
