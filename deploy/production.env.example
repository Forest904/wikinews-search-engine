ELASTIC_PASSWORD=REPLACE_WITH_RANDOM_SECRET
APP_IMAGE=newsfinder-app:local
ANNOTATION_DB=/app/data/annotation/annotation.sqlite3
# Space-separated CIDRs from https://www.cloudflare.com/ips/
# Populate using scripts/server.sh cloudflare-ips, then copy its output here.
CLOUDFLARE_CIDRS=

# Mostra la ricerca semantica dopo la verifica della collezione Qdrant.
SEMANTIC_ENABLED=0
